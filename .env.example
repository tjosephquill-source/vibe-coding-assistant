# ── VibeCodingAssistant Environment Variables ──────────────────────
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# OpenAI API key (required for LLM features: descriptions, chat, previews, TTS)
OPENAI_API_KEY=sk-your-key-here

# LLM model to use for all AI-powered features
# Options: gpt-4o-mini, gpt-4o, gpt-4.1-mini, gpt-4.1, gpt-5.4-mini, gpt-5.4
LLM_MODEL=gpt-4o-mini

